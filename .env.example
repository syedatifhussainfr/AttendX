NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=attendx
JWT_AUDIENCE=attendx-web
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_SESSION_DAYS=14
ADMIN_PHONE_COUNTRY_CODE=+91
ADMIN_PHONE_LOCAL_DIGITS=10

# Fast local default
DB_DIALECT=sqlite
SQLITE_PATH=./data/attendx.sqlite
BACKUP_DIR=./backups

# PostgreSQL / Supabase (set DB_DIALECT=postgres)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/attendx
# DB_SSL=false
